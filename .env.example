# Real Slack is OFF by default and is not used by this demo.
# Even if you fill these in, the portfolio app will refuse to post
# (see approvalgate/slack_adapter.py). Leave them unset.

# APPROVAL_GATE_SLACK_ENABLED=false
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# SLACK_APPROVAL_CHANNEL=

# Defaults used by ./run.sh
# TEMPORAL_ADDRESS=127.0.0.1:7233
# APPROVAL_GATE_TASK_QUEUE=approval-gate
